{
  "name": "@evilmartians/design-lint",
  "version": "0.1.1",
  "type": "module",
  "description": "Design-token lint rules for Tailwind v4 codebases, for Oxlint and ESLint",
  "bin": {
    "design-lint": "./src/cli.js"
  },
  "scripts": {
    "test": "vitest run",
    "generate:colors": "node scripts/generate-color-names.mjs"
  },
  "devDependencies": {
    "@tailwindcss/node": "^4.3.3",
    "oxlint": "^1.82.0",
    "tailwindcss": "^4.3.3",
    "vitest": "^3.2.4"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evilmartians/design-lint.git"
  },
  "keywords": [
    "oxlint",
    "oxlint-plugin",
    "tailwindcss",
    "design-tokens",
    "design-system",
    "lint"
  ],
  "exports": {
    "./preset": "./src/preset/index.js",
    "./oxlint": "./src/oxlint.js",
    "./policy": "./src/policy/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "docs/rules",
    "README.md",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "oxlint": ">=1.82.0",
    "@tailwindcss/node": ">=4.1.0"
  },
  "engines": {
    "node": "^22.18.0 || >=23.6.0"
  },
  "peerDependenciesMeta": {
    "@tailwindcss/node": {
      "optional": true
    }
  }
}
